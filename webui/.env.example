# Copy to .env and fill in. The server pays for all AI usage with this key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# MODEL=claude-sonnet-5
# MAX_TOKENS=2048
# PORT=3000

# Per-IP rate limit (server pays, so keep this sane for a public deploy):
# RATE_WINDOW_MS=3600000   # 1 hour
# RATE_MAX=20              # AI calls per window per IP
